# Copy this file to .env and adjust for your environment.

# PostgreSQL connection string used by the API server and drizzle-kit.
# The default points at the embedded development database (`pnpm dev:db`).
# For production with Supabase, set this to your Supabase connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/jump_proptech

# Supabase configuration (for hosted production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API server port.
PORT=8080

# Allowed browser origin for credentialed requests (Vite dev server).
WEB_ORIGIN=http://localhost:5173

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Set to production when serving over HTTPS so the session cookie is marked secure.
NODE_ENV=development

# Frontend Supabase env vars (Vite prefix required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
