{
  "name": "jump-proptech",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/jump-proptech run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "start": "pnpm --filter @workspace/api-server run start",
    "db:sql": "node scripts/db-sql.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
